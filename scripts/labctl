#!/usr/bin/env sh
set -eu

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
binary="$repository_root/tools/labctl/bin/labctl"

if [ ! -x "$binary" ] || [ -n "$(find "$repository_root/tools/labctl/cmd" "$repository_root/tools/labctl/internal" "$repository_root/tools/labctl/go.mod" "$repository_root/tools/labctl/go.sum" -type f -newer "$binary" -print -quit)" ]; then
  echo "Building labctl..." >&2
  (cd "$repository_root/tools/labctl" && mkdir -p bin && go build -o bin/labctl ./cmd/labctl)
fi

export LABCTL_ROOT="$repository_root"
exec "$binary" "$@"
