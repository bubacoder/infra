{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "infra-mcp": {
      "type": "local",
      "command": ["uv", "run", "--directory", "scripts/infra-mcp", "server.py"],
      "environment": {
        "ENABLE_TASK_TOOLS": "false",
        "ENABLE_CONTAINER_TOOLS": "true"
      }
    }
  }
}
