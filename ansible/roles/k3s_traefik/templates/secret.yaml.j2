apiVersion: v1
kind: Secret
metadata:
  name: bootstrap-traefik-cloudflare
  namespace: kube-system
  labels:
    app.kubernetes.io/managed-by: infra-bootstrap-traefik
    infra.bootstrap/deployment: {{ bootstrap.name | to_json }}
type: Opaque
data:
  token: {{ k3s_traefik_token | b64encode | to_json }}
{% if bootstrap.k3s.crowdsec.enabled | default(false) %}
  bouncer-key: {{ k3s_crowdsec_bouncer_key | b64encode | to_json }}
{% endif %}
