  name: bootstrap-traefik-cloudflare
  namespace: kube-system
  labels:
    app.kubernetes.io/managed-by: infra-bootstrap-traefik
    infra.bootstrap/deployment: {{ bootstrap.name | to_json }}
type: Opaque
data:
  token: {{ k3s_traefik_token | b64encode | to_json }}
