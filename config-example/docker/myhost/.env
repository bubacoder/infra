# Host-specific Docker Compose environment variables

### Storage - Located on main node

DOCKER_VOLUMES=/mnt/docker-volumes

STORAGE_LOCAL=/mnt/st-ironwolf-10t

STORAGE_DOWNLOADS=${STORAGE_LOCAL}/download
STORAGE_TORRENT_DOWNLOADS=${STORAGE_LOCAL}/download/torrent-downloads
STORAGE_BACKUP=${STORAGE_LOCAL}/backup

# Media
STORAGE_MEDIA=${STORAGE_LOCAL}/media
STORAGE_FAMILYMEDIA=${STORAGE_LOCAL}/family-media
STORAGE_CALIBRE_LIBRARY=${STORAGE_MEDIA}/books
# Calibre-Web Automated ingest dir - all files placed here are removed after processing
STORAGE_CWA_INGEST_PATH=${STORAGE_MEDIA}/cwa-ingest
STORAGE_BACKGROUNDS=${STORAGE_MEDIA}/backgrounds
STORAGE_KIWIX=${STORAGE_MEDIA}/kiwix
STORAGE_SYNCTHING=${STORAGE_LOCAL}/family-media/syncthing

# Services, docs
STORAGE_FRIGATE=${STORAGE_LOCAL}/service/frigate
STORAGE_WEBDAV=${STORAGE_LOCAL}/service/webdav
STORAGE_OBSIDIAN=${ADMIN_HOME}/repos/today/vault

### Hosts
LOCAL_NODE_IP=xxx.xxx.xxx.xxx


### Hardware acceleration
# Vendor-specific suffix selects the GPU override file per service.
# amdgpu: VAAPI/ROCm on AMD iGPU/dGPU  |  nvidia: CUDA/NVENC (future)
# Loads docker/<category>/<service>/<service>-<suffix>.yaml alongside the base compose file.
GPU_COMPOSE_SUFFIX=amdgpu
GPU_RENDER_GID=990   # getent group render | cut -d: -f3
GPU_VIDEO_GID=44     # getent group video  | cut -d: -f3


# --------------------------------
# Operational settings not consumed by Docker Compose deployments


# You can create an API key from inside Jellyfin at Settings > Advanced > API Keys
JELLYFIN_API_KEY="use-some-very-secure-value-here"


OPEN_WEBUI_AUTHENTIK_SIGNING_KEY="use-some-very-secure-value-here"

### Gitea Authentik OIDC configuration
GITEA_AUTHENTIK_CLIENT_ID="gitea"
GITEA_AUTHENTIK_CLIENT_SECRET="use-some-very-secure-value-here"
GITEA_AUTHENTIK_SIGNING_KEY="use-some-very-secure-value-here"
