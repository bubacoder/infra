# Ubuntu cloud-image VM configuration, initialized in config/bootstrap-proxmox/.
# No secrets: bootstrap transfers the controller public key selected in host.yaml.

PROXMOX_HOST=proxmox

# renovate: datasource=endoflife depName=ubuntu
UBUNTU_VERSION=26.04

USERNAME=admin
VMNAME=ubuntu-cloud
VMID=400
CPU_CORES=4
MAX_MEMORY_SIZE=4096 # MiB
MIN_MEMORY_SIZE=1024 # MiB; memory ballooning minimum
DISK_SIZE=256G       # Thin-provisioned virtual disk size

VM_STORAGE=local-lvm
VM_BRIDGE=vmbr0
VM_MAC=
EXPECTED_IPV4=
