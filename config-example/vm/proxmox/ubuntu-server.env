# Ubuntu installer VM configuration. Copy to config/vm/proxmox/ and edit.
# No secret values are required: the VM receives the Proxmox user's SSH public key.

# Check https://releases.ubuntu.com/ for the selected release.
UBUNTU_VERSION=26.04

# true: Use the LVM autoinstall configuration (one console confirmation required).
# false: Start the manual Ubuntu installer.
AUTOINSTALL=true

USERNAME=admin
VMNAME=ubuntu-server
VMID=300
CPU_CORES=4
MAX_MEMORY_SIZE=4096 # MiB
MIN_MEMORY_SIZE=1024 # MiB; memory ballooning minimum
DISK_SIZE=256G       # Thin-provisioned virtual disk size

VM_STORAGE=local-lvm
VM_BRIDGE=vmbr0
