FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# hadolint ignore=DL3018
RUN apk add --no-cache gettext

COPY envsubst-entrypoint.sh /usr/local/bin/envsubst-entrypoint
RUN chmod 755 /usr/local/bin/envsubst-entrypoint

USER 1000:1000

ENTRYPOINT ["/usr/local/bin/envsubst-entrypoint"]
